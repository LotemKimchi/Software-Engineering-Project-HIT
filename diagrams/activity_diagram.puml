@startuml Activity_AllProcesses
title TaskMaster Pro - Activity Diagram\nשלושה תהליכים עסקיים

skinparam ActivityBackgroundColor #ffffff
skinparam ActivityBorderColor #336699
skinparam ActivityArrowColor #336699
skinparam PartitionBackgroundColor #fafafa
skinparam PartitionBorderColor #666666
skinparam PartitionFontSize 13
skinparam PartitionFontStyle bold

start

fork

  partition "תהליך 1: הרשמה והתחברות" {
    :הצגת תפריט ראשי;
    if (משתמש חדש?) then ([כן])
      :הזנת שם משתמש, סיסמה ותחום מקצועי;
      if (ולידציה תקינה?\nשם ייחודי + סיסמה >= 8 תווים) then ([כן])
        :הצפנת סיסמה (Hashing);
        :שמירת משתמש לקובץ מקומי;
        :הצגת הודעת הצלחה;
        detach
      else ([לא])
        :הצגת שגיאת ולידציה;
        detach
      endif
    else ([לא - משתמש קיים])
      :הזנת שם משתמש וסיסמה;
      if (פרטים תקינים?) then ([כן])
        :איפוס מונה כניסות כושלות;
        :טעינת סשן ומשימות לפי תחום;
        :הצגת דשבורד + רשימת משימות;
      else ([לא])
        :הגדלת מונה כניסות כושלות;
        if (3 ניסיונות כושלים?) then ([כן])
          :חסימת חשבון ל-15 דקות;
          :הצגת הודעת חסימה;
          detach
        else ([לא])
          :הצגת שגיאה - נסה שוב;
          detach
        endif
      endif
    endif
  }

fork again

  partition "תהליך 2: יצירת משימה / באג" {
    :בחירת "צור משימה חדשה" מהתפריט;
    :הזנת כותרת (עד 50 תווים) ותיאור;
    :בחירת סוג: משימה / באג;
    if (סוג = באג?) then ([כן])
      :הזנת צעדי שחזור\n(Steps to Reproduce) - חובה;
      if (שדה מולא?) then ([לא])
        :שגיאה - שדה חובה;
        detach
      else ([כן])
      endif
    endif
    :בחירת דחיפות: נמוכה / בינונית / גבוהה;
    :הזנת תאריך יעד (YYYY/MM/DD);
    if (תאריך תקין (לא בעבר)?) then ([כן])
      :שיוך אוטומטי לתחום המשתמש;
      :יצירת מזהה ייחודי (ID) אוטומטי;
      :הגדרת סטטוס: "חדש";
      :שמירה מיידית לקובץ מקומי;
      :הצגת אישור + מזהה המשימה;
    else ([לא])
      :שגיאת ולידציה - תאריך לא חוקי;
      detach
    endif
  }

fork again

  partition "תהליך 3: ניהול מחזור חיים של משימה" {
    :בחירת משימה מרשימת המשימות;
    :הצגת פרטי המשימה ותפריט פעולות;
    if (פעולה = עריכה?) then ([כן])
      if (סטטוס = "בוצע"?) then ([כן])
        :שגיאה - לא ניתן לערוך משימה סגורה;
        detach
      else ([לא])
        :עריכת כותרת / תיאור / דחיפות;
        :שמירה אוטומטית לקובץ;
        :הצגת אישור שמירה;
      endif
    else ([לא])
      if (פעולה = עדכון סטטוס?) then ([כן])
        if (סטטוס נוכחי = "חדש"?) then ([כן])
          :שינוי סטטוס ל-"בטיפול";
        else ([לא - "בטיפול"])
          :שינוי סטטוס ל-"בוצע";
          :תיעוד זמן סגירה (Timestamp);
        endif
        :שמירה לקובץ;
      else ([לא - מחיקה])
        :הצגת Confirmation Dialog;
        if (משתמש מאשר מחיקה?) then ([כן])
          :מחיקת המשימה ממסד הנתונים;
          :שמירה מיידית לקובץ;
        else ([לא])
          :ביטול - חזרה לרשימה;
          detach
        endif
      endif
    endif
    :חזרה לרשימת המשימות;
  }

end fork

stop
@enduml
