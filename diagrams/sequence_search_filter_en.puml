@startuml Sequence_SearchFilter_EN
title UC3: Search and Filter Tasks

skinparam SequenceArrowThickness 2
skinparam ParticipantBackgroundColor #fff8f0
skinparam ParticipantBorderColor #996633

actor "User" as User
participant "UIController" as UI
participant "TaskService" as TaskSvc
participant "TaskRepository" as Repo
database "Local Data File\n(tasks.json)" as DB
participant "SearchFilter" as SF

User -> UI: Select search / filter / sort action
activate UI

alt Text search
  User -> UI: Enter search string
  UI -> TaskSvc: searchTasks(query, domain)
  activate TaskSvc
  TaskSvc -> Repo: findByDomain(domain)
  activate Repo
  Repo -> DB: read(domain)
  activate DB
  DB --> Repo: List<Task>
  deactivate DB
  Repo --> TaskSvc: List<Task>
  deactivate Repo
  TaskSvc -> SF: filterByText(tasks, query)
  activate SF
  SF -> SF: Match query in title and description
  SF --> TaskSvc: Filtered List<Task>
  deactivate SF
  TaskSvc --> UI: Search results
  deactivate TaskSvc

else Filter by status "In Progress"
  User -> UI: Select filter "In Progress"
  UI -> TaskSvc: filterByStatus(IN_PROGRESS, domain)
  activate TaskSvc
  TaskSvc -> Repo: findByDomain(domain)
  activate Repo
  Repo -> DB: read(domain)
  activate DB
  DB --> Repo: List<Task>
  deactivate DB
  Repo --> TaskSvc: List<Task>
  deactivate Repo
  TaskSvc -> SF: filterByStatus(tasks, IN_PROGRESS)
  activate SF
  SF --> TaskSvc: List<Task> with status "In Progress" only
  deactivate SF
  TaskSvc --> UI: Filtered list
  deactivate TaskSvc

else Sort by due date
  User -> UI: Select chronological sort
  UI -> TaskSvc: sortByDueDate(domain)
  activate TaskSvc
  TaskSvc -> Repo: findByDomain(domain)
  activate Repo
  Repo -> DB: read(domain)
  activate DB
  DB --> Repo: List<Task>
  deactivate DB
  Repo --> TaskSvc: List<Task>
  deactivate Repo
  TaskSvc -> SF: sortAscendingByDueDate(tasks)
  activate SF
  SF --> TaskSvc: Sorted List<Task>
  deactivate SF
  TaskSvc --> UI: Sorted list
  deactivate TaskSvc
end

alt No results found
  UI --> User: Display message - no tasks found
else Results found
  UI --> User: Display filtered/sorted task list\n(sorted by priority by default)
end

deactivate UI

@enduml
