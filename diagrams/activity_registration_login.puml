@startuml Activity_Registration_Login
title תהליך הרשמה והתחברות למערכת

skinparam ActivityBackgroundColor #f0f8ff
skinparam ActivityBorderColor #336699
skinparam ArrowColor #336699

start

:הצגת תפריט ראשי: התחברות / הרשמה;

if (משתמש חדש?) then (כן)
  :הזנת שם משתמש, סיסמה ותחום מקצועי;
  if (שם משתמש ייחודי\nוסיסמה >= 8 תווים?) then (תקין)
    :הצפנת סיסמה (Hashing);
    :יצירת חשבון משתמש;
    :שמירה לקובץ מקומי;
    :הצגת הודעת הצלחה;
    :מעבר למסך ההתחברות;
  else (לא תקין)
    :הצגת הודעת שגיאה;
    stop
  endif
else (לא - משתמש קיים)
  :הזנת שם משתמש וסיסמה;
  :אימות נגד מסד הנתונים המקומי;
  if (פרטים תקינים?) then (כן)
    :איפוס מונה הכניסות הכושלות;
    :טעינת סשן משתמש;
    :טעינת משימות לפי תחום מקצועי;
    :הצגת רשימת משימות + דשבורד;
    stop
  else (לא)
    :הגדלת מונה כניסות כושלות;
    if (3 ניסיונות כושלים?) then (כן)
      :חסימת חשבון ל-15 דקות;
      :הצגת הודעת חסימה;
      stop
    else (לא)
      :הצגת הודעת שגיאה;
      :חזרה לטופס התחברות;
    endif
  endif
endif

stop
@enduml
