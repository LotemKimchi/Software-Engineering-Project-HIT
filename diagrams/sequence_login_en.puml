@startuml Sequence_Login_EN
title UC1: User Login

skinparam SequenceArrowThickness 2
skinparam ParticipantBackgroundColor #e8f4f8
skinparam ParticipantBorderColor #336699

actor "User" as User
participant "UIController" as UI
participant "AuthService" as Auth
participant "UserRepository" as Repo
database "Local Data File\n(users.json)" as DB
participant "Session" as Session

User -> UI: Enter username and password
activate UI

UI -> Auth: authenticate(username, password)
activate Auth

Auth -> Repo: findByUsername(username)
activate Repo

Repo -> DB: read(username)
activate DB
DB --> Repo: User record / null
deactivate DB

Repo --> Auth: User / null
deactivate Repo

alt User not found
  Auth --> UI: AuthResult.USER_NOT_FOUND
  UI --> User: Display error - user does not exist

else User found
  Auth -> Auth: verifyPassword(input, storedHash)

  alt Wrong password
    Auth -> Auth: incrementFailedAttempts()

    alt Failed attempts >= 3
      Auth -> Repo: lockAccount(username, 15min)
      activate Repo
      Repo -> DB: update(lockedUntil)
      activate DB
      DB --> Repo: confirmed
      deactivate DB
      Repo --> Auth: confirmed
      deactivate Repo
      Auth --> UI: AuthResult.ACCOUNT_LOCKED
      UI --> User: Account locked for 15 minutes

    else Failed attempts < 3
      Auth --> UI: AuthResult.WRONG_PASSWORD
      UI --> User: Error - wrong credentials, X attempts remaining
    end

  else Password correct
    Auth -> Auth: resetFailedAttempts()
    Auth -> Session: createSession(user)
    activate Session
    Session --> Auth: session created
    deactivate Session
    Auth --> UI: AuthResult.SUCCESS
    deactivate Auth
    UI -> UI: loadTasksByDomain(user.domain)
    UI --> User: Display task list + dashboard
  end
end

deactivate UI

@enduml
