@startuml Activity_CreateTask_EN
title Create Task / Bug Process

skinparam ActivityBackgroundColor #f0fff0
skinparam ActivityBorderColor #336633
skinparam ArrowColor #336633

start

:Logged-in user selects "Create Task";
:Enter title (up to 50 characters);
:Enter detailed description;
:Select type: Task / Bug;

if (Type = Bug?) then (yes)
  :Enter Steps to Reproduce\n(mandatory field);
  if (Steps to Reproduce filled?) then (no)
    :Display error - mandatory field;
    stop
  else (yes)
  endif
endif

:Select priority level: Low / Medium / High;
:Enter due date (YYYY/MM/DD);

if (Date valid (not in the past)?) then (valid)
  :Auto-assign to user's domain;
  :Generate unique task ID;
  :Set status: "New";
  :Immediately save to local file;
  :Display confirmation + task ID;
else (invalid)
  :Display validation error;
  :Request new date entry;
  stop
endif

stop
@enduml
