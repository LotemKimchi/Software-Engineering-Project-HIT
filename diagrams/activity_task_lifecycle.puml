@startuml Activity_TaskLifecycle
title תהליך ניהול מחזור חיים של משימה

skinparam ActivityBackgroundColor #fff8f0
skinparam ActivityBorderColor #996633
skinparam ArrowColor #996633

start

:משתמש בוחר משימה מהרשימה;
:הצגת פרטי המשימה ותפריט פעולות;

if (פעולה = עריכה?) then ([כן])
  if (סטטוס = "בוצע"?) then ([כן])
    :הצגת שגיאה - לא ניתן לערוך משימה סגורה;
    stop
  else ([לא])
    :עריכת כותרת / תיאור / דחיפות;
    :שמירה אוטומטית לקובץ;
    :הצגת אישור שמירה;
  endif
else ([לא - עדכון סטטוס / מחיקה])
  if (פעולה = עדכון סטטוס?) then ([כן])
    if (סטטוס נוכחי = "חדש"?) then ([כן])
      :שינוי סטטוס ל-"בטיפול";
      :שמירה לקובץ;
    else ([לא])
      if (סטטוס נוכחי = "בטיפול"?) then ([כן])
        :שינוי סטטוס ל-"בוצע";
        :תיעוד זמן סגירה (Timestamp);
        :שמירה לקובץ;
      else ([כן - כבר "בוצע"])
        :הצגת הודעה - המשימה כבר הושלמה;
        stop
      endif
    endif
  else ([לא - מחיקה])
    :הצגת דיאלוג אישור מחיקה;
    if (משתמש מאשר?) then ([כן])
      :מחיקת המשימה ממסד הנתונים;
      :שמירה מיידית לקובץ;
      :הצגת הודעת הצלחה;
    else ([לא])
      :ביטול פעולה;
      stop
    endif
  endif
endif

:חזרה לרשימת המשימות;
stop
@enduml
