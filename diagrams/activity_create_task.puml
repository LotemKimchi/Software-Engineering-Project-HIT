@startuml Activity_CreateTask
title תהליך יצירת משימה / באג

skinparam ActivityBackgroundColor #f0fff0
skinparam ActivityBorderColor #336633
skinparam ArrowColor #336633

start

:משתמש מחובר בוחר "יצירת משימה";
:הזנת כותרת (עד 50 תווים);
:הזנת תיאור מפורט;
:בחירת סוג: משימה / באג;

if (סוג = באג?) then (כן)
  :הזנת צעדי שחזור\n(Steps to Reproduce) - חובה;
  if (שדה צעדי שחזור מולא?) then (לא)
    :הצגת שגיאה - שדה חובה;
    stop
  else (כן)
  endif
endif

:בחירת רמת דחיפות: נמוכה / בינונית / גבוהה;
:הזנת תאריך יעד (YYYY/MM/DD);

if (תאריך תקין (לא בעבר)?) then (תקין)
  :שיוך אוטומטי לתחום המשתמש;
  :יצירת מזהה ייחודי (ID);
  :הגדרת סטטוס: "חדש";
  :שמירה מיידית לקובץ המקומי;
  :הצגת אישור + מזהה המשימה;
else (לא תקין)
  :הצגת שגיאת ולידציה;
  :בקשת הזנה מחדש של תאריך;
  stop
endif

stop
@enduml
