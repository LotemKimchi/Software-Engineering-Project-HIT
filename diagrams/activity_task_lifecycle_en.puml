@startuml Activity_TaskLifecycle_EN
title Task Lifecycle Management Process

skinparam ActivityBackgroundColor #fff8f0
skinparam ActivityBorderColor #996633
skinparam ArrowColor #996633

start

:User selects a task from the list;
:Display task details and action menu;

if (Action = Edit?) then ([yes])
  if (Status = "Done"?) then ([yes])
    :Display error - cannot edit a closed task;
    stop
  else ([no])
    :Edit title / description / priority;
    :Auto-save to file;
    :Display save confirmation;
  endif
else ([no - Update Status / Delete])
  if (Action = Update Status?) then ([yes])
    if (Current status = "New"?) then ([yes])
      :Change status to "In Progress";
      :Save to file;
    else ([no])
      if (Current status = "In Progress"?) then ([yes])
        :Change status to "Done";
        :Record close timestamp;
        :Save to file;
      else ([yes - already "Done"])
        :Display message - task already completed;
        stop
      endif
    endif
  else ([no - Delete])
    :Display deletion Confirmation Dialog;
    if (User confirms?) then ([yes])
      :Delete task from data store;
      :Immediately save to file;
      :Display success message;
    else ([no])
      :Cancel action;
      stop
    endif
  endif
endif

:Return to task list;
stop
@enduml
