@startuml Sequence_CreateTask_EN
title UC2: Create Task / Bug

skinparam SequenceArrowThickness 2
skinparam ParticipantBackgroundColor #f0fff0
skinparam ParticipantBorderColor #336633

actor "User" as User
participant "UIController" as UI
participant "Validator" as Val
participant "TaskService" as TaskSvc
participant "TaskRepository" as Repo
database "Local Data File\n(tasks.json)" as DB

User -> UI: Select "Create New Task"
activate UI
UI --> User: Display creation form

User -> UI: Submit task details:\ntitle, description, type, priority, dueDate

UI -> Val: validateTitle(title)
activate Val
Val --> UI: OK / error (> 50 chars)
deactivate Val

UI -> Val: validateDueDate(dueDate)
activate Val
Val --> UI: OK / error (past date)
deactivate Val

alt Validation failed
  UI --> User: Display specific validation error

else Validation passed
  alt Task type = Bug
    UI --> User: Request Steps to Reproduce (mandatory)
    User -> UI: Enter stepsToReproduce
  end

  UI -> TaskSvc: createTask(title, desc, type, priority, dueDate, user)
  activate TaskSvc
  TaskSvc -> TaskSvc: generateUniqueId()
  TaskSvc -> TaskSvc: setDomain(user.domain)
  TaskSvc -> TaskSvc: setStatus(NEW)

  TaskSvc -> Repo: save(task)
  activate Repo
  Repo -> DB: write(taskData)
  activate DB

  alt File write error
    DB --> Repo: IOException
    deactivate DB
    Repo -> DB: retry (attempt 2/3)
    activate DB
    DB --> Repo: IOException
    deactivate DB
    Repo --> TaskSvc: SaveException
    deactivate Repo
    TaskSvc --> UI: SaveException
    deactivate TaskSvc
    UI --> User: Error - could not save, please try again

  else Save successful
    DB --> Repo: success
    deactivate DB
    Repo --> TaskSvc: task saved
    deactivate Repo
    TaskSvc --> UI: task (with id)
    deactivate TaskSvc
    UI --> User: Task created successfully + ID: {id}
  end
end

deactivate UI

@enduml
